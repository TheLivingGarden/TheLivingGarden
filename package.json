{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "prestart": "node patch-glbs.cjs",
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS --import \\\"$PWD/server-watchdog.mjs\\\"\" sdk-commands start",
    "predeploy": "node patch-glbs.cjs && node check-glb.cjs",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs",
    "postinstall": "node patch-node-modules.cjs",
    "check-glb": "node check-glb.cjs",
    "test": "jest"
  },
  "devDependencies": {
    "@dcl/gltf-validator-ts": "^1.0.19",
    "@dcl/js-runtime": "https://sdk-team-cdn.decentraland.org/@dcl/js-sdk-toolchain/branch/fix/storage-read-failure-throws/@dcl/js-runtime/dcl-js-runtime-7.29.1-36021790753.commit-72e1674.tgz",
    "@dcl/sdk": "https://sdk-team-cdn.decentraland.org/@dcl/js-sdk-toolchain/branch/fix/storage-read-failure-throws/dcl-sdk-7.29.1-36021790753.commit-72e1674.tgz",
    "@dcl/sdk-commands": "https://sdk-team-cdn.decentraland.org/@dcl/js-sdk-toolchain/branch/fix/storage-read-failure-throws/dcl-sdk-commands-7.29.1-36021790753.commit-72e1674.tgz",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
