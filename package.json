{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS --import \\\"$PWD/server-watchdog.mjs\\\"\" sdk-commands start",
    "predeploy": "node check-glb.cjs",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs",
    "postinstall": "node patch-node-modules.cjs",
    "check-glb": "node check-glb.cjs",
    "patch-glbs": "node patch-glbs.cjs",
    "test": "jest"
  },
  "devDependencies": {
    "@dcl/gltf-validator-ts": "^1.0.19",
    "@dcl/js-runtime": "7.26.1-32160793830.commit-0b97733",
    "@dcl/sdk": "7.26.1-32160793830.commit-0b97733",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}